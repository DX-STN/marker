<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title>Body Click Circle</title>
  <style>
    html, body {
      margin: 0;
      padding: 0;
      height: 100%;
    }
    body {
      position: relative;
      background: #f5f5f5;
      cursor: crosshair;
      font-family: system-ui, sans-serif;
    }
    .marker {
      position: absolute;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      pointer-events: none;
    }
.h1 {
color:#f00;
}
  </style>
</head>
<body>
<h1>OK！</h1>

<script>
  // 画面クリックでその位置に○を付ける処理
  function handleBodyClick(event) {
    // 既存のマーカーを消す
    const old = document.querySelector('.marker');
    if (old) old.remove();

    // 新しいマーカー要素を作成
    const marker = document.createElement('div');
    marker.className = 'marker';

    // 白い外側
    marker.style.boxShadow = '0 0 0 2px #fff, 0 0 0 4px #000';

    // 中心がクリック位置に来るように調整
    const size = 16;
    const x = event.clientX - size / 2;
    const y = event.clientY - size / 2;

    marker.style.left = x + 'px';
    marker.style.top = y + 'px';

    document.body.appendChild(marker);
  }

  // body 全体にイベントを付ける
  document.body.addEventListener('click', handleBodyClick);
</script>

</body>
</html>
